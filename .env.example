# ==============================================================================
# Hulu Academy — Environment Variables (.env.local)
# ==============================================================================

# ---- 1. Supabase PostgreSQL Connection Strings ------------------------------
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=
DIRECT_URL=

# ---- 2. Supabase API & Storage (For course materials signed URLs) ------------
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hulu-materials

# ---- 3. Telegram Bot & Channel Configuration --------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=Hulu_Academy_Tutors_bot
NEXT_PUBLIC_BOT_USERNAME=Hulu_Academy_Tutors_bot

# Target Channel Telegram ID (Must be negative, e.g. -100XXXXXXXXXX)
TELEGRAM_TARGET_CHAT_ID=

# Channel username without '@' (used for the "Join Channel" button in the app)
NEXT_PUBLIC_CHANNEL_USERNAME=

# Webhook secret for securing the incoming Telegram updates endpoint
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-secret

# ---- 4. Admin Access ---------------------------------------------------------
# Comma-separated list of Telegram user IDs who have Admin panel permissions
ADMIN_TELEGRAM_IDS=

# ---- 5. Application URLs & Auth Secrets --------------------------------------
APP_URL=http://localhost:3000
MINI_APP_URL=http://localhost:3000

# Remotely-managed Cloudflare Tunnel token (not a Cloudflare account API token).
# Get this from Cloudflare Dashboard -> Networking -> Tunnels -> your tunnel -> Add a replica.
CLOUDFLARE_TUNNEL_TOKEN=

# Session encryption key (min 64 chars)
SESSION_SECRET=dev-secret-change-in-production-min-64-chars-hulu-academy-tutors
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ---- 6. Environment ----------------------------------------------------------
NODE_ENV=development
